# Copie para .env e preencha. O .env está no .gitignore — nunca commite ele.

# Google AI Studio (https://aistudio.google.com/apikey) — obrigatório
GEMINI_API_KEY=

# Picovoice Console (https://console.picovoice.ai) — obrigatório para o wake word
PORCUPINE_ACCESS_KEY=

# OpenRouter (https://openrouter.ai/keys) — opcional, fallback quando o Gemini
# devolve 429. Sem crédito: 50 req/dia. Com US$ 10 vitalícios: 1.000 req/dia.
OPENROUTER_API_KEY=

# ElevenLabs (https://elevenlabs.io) — opcional, voz na nuvem.
# Plano grátis: 10.000 caracteres/mês. Só a frase final é sintetizada, então
# raciocínio e busca não contam. Sem esta chave, o James usa o Piper local.
ELEVENLABS_API_KEY=
